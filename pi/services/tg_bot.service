[Unit]
Description=FPV Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/fpv/fpv.env
ExecStart=/usr/bin/python3 /home/pi/fpv/scripts/tg_bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
